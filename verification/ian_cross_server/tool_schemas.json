              "default": "MHHW"
            },
            "units": {
              "$ref": "#/$defs/Units",
              "default": "metric"
            }
          },
          "required": [
            "station_id"
          ],
          "title": "coops_get_flood_statsArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "coops_get_flood_statsOutput",
          "type": "object"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      },
      {
        "name": "coops_get_sea_level_trends",
        "description": "Get sea level trend data for a CO-OPS station.\n\nReturns the long-term linear sea level trend with confidence intervals.\n\nArgs:\n    station_id: CO-OPS station ID (e.g., '8518750' for The Battery, NY).\n",
