      {
        "name": "coops_get_flood_stats",
        "description": "Get annual flood day counts and high tide flooding outlook for a CO-OPS station.\n\nCombines data from the annual flood count and high tide flooding outlook endpoints.\n\nArgs:\n    station_id: CO-OPS station ID (e.g., '8518750' for The Battery, NY).\n    year: Optional specific year to query.\n    datum: Vertical datum reference (default: MHHW).\n    units: Unit system \u2014 'metric' or 'english' (default: metric).\n",
        "inputSchema": {
          "$defs": {
            "Datum": {
              "enum": [
                "MLLW",
                "MHHW",
                "MSL",
                "NAVD",
                "STND",
                "MHW",
                "MLW",
                "MTL",
                "IGLD",
                "LWD"
              ],
              "title": "Datum",
