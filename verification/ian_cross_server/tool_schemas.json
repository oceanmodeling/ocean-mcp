            },
            "Units": {
              "enum": [
                "metric",
                "english"
              ],
              "title": "Units",
              "type": "string"
            }
          },
          "properties": {
            "station_id": {
              "title": "Station Id",
              "type": "string"
            },
            "year": {
              "anyOf": [
